{"name":"木须肉","intro":"经典鲁菜，肉片滑嫩配蛋香木耳。","category":"家常小炒","meat_tag":"荤","difficulty":2,"minutes":25,"calorie_tier":"中","ingredients":[{"name":"猪里脊","amount":"150g"},{"name":"鸡蛋","amount":"2个"},{"name":"干木耳","amount":"5g"},{"name":"黄瓜","amount":"半根"},{"name":"葱","amount":"1段"},{"name":"姜","amount":"2片"},{"name":"生抽","amount":"10ml"},{"name":"料酒","amount":"10ml"},{"name":"盐","amount":"3g"},{"name":"食用油","amount":"20ml"}],"steps":["干木耳温水泡发20分钟，去蒂撕小朵","里脊切薄片，加料酒、生抽和少许淀粉抓匀腌10分钟","鸡蛋加少许盐打散，热油炒成大块盛出","锅内补油，下肉片滑炒至变色盛出","爆香葱姜，下木耳和黄瓜片大火翻炒1分钟","回锅肉片和鸡蛋，加盐快速翻炒均匀即可"],"nutrition":{"kcal":350,"protein":26,"fat":22,"carb":10}},
{"name":"京酱肉丝","intro":"甜面酱香浓，卷豆皮吃更地道。","category":"家常小炒","meat_tag":"荤","difficulty":2,"minutes":30,"calorie_tier":"中","ingredients":[{"name":"猪里脊","amount":"250g"},{"name":"甜面酱","amount":"30g"},{"name":"大葱","amount":"1根"},{"name":"豆腐皮","amount":"2张"},{"name":"蛋清","amount":"半个"},{"name":"淀粉","amount":"5g"},{"name":"料酒","amount":"10ml"},{"name":"白糖","amount":"5g"},{"name":"食用油","amount":"25ml"}],"steps":["里脊切细丝，加料酒、蛋清和淀粉抓匀腌15分钟","大葱取葱白切细丝，清水泡5分钟去辣摆盘","豆腐皮切块，和葱丝一起垫盘底","油烧至四成热下肉丝滑散炒至变白盛出","底油小火下甜面酱和白糖炒出香味","倒回肉丝快速翻裹酱汁，盛在葱丝上卷豆皮吃"],"nutrition":{"kcal":420,"protein":30,"fat":24,"carb":18}},
{"name":"蒜苔炒肉","intro":"蒜苔脆嫩肉丝香，下饭神器。","category":"家常小炒","meat_tag":"荤","difficulty":1,"minutes":20,"calorie_tier":"中","ingredients":[{"name":"蒜苔","amount":"200g"},{"name":"猪里脊","amount":"150g"},{"name":"生抽","amount":"10ml"},{"name":"料酒","amount":"10ml"},{"name":"淀粉","amount":"3g"},{"name":"盐","amount":"3g"},{"name":"姜","amount":"2片"},{"name":"食用油","amount":"20ml"}],"steps":["蒜苔切3厘米段，加盐抓一下更入味","里脊切丝，用料酒、生抽和淀粉腌10分钟","热油下姜丝和肉丝炒变色盛出","原锅下蒜苔中火炒2分钟至表皮起皱","回锅肉丝，加盐和少许生抽炒匀出锅"],"nutrition":{"kcal":320,"protein":24,"fat":18,"carb":12}},
{"name":"芹菜炒香干","intro":"清爽脆嫩，素菜也能很下饭。","category":"家常小炒","meat_tag":"素","difficulty":1,"minutes":15,"calorie_tier":"低","ingredients":[{"name":"芹菜","amount":"200g"},{"name":"香干","amount":"150g"},{"name":"蒜","amount":"2瓣"},{"name":"干辣椒","amount":"2个"},{"name":"生抽","amount":"8ml"},{"name":"盐","amount":"3g"},{"name":"食用油","amount":"15ml"}],"steps":["芹菜撕去老筋切段，香干切薄片","水开加少许盐，芹菜焯水30秒过凉","热油爆香蒜片和干辣椒","下香干中火煎炒1分钟至微黄","倒回芹菜大火翻炒，加生抽和盐炒匀"],"nutrition":{"kcal":210,"protein":12,"fat":11,"carb":14}},
{"name":"洋葱炒鸡蛋","intro":"洋葱微甜蛋液嫩滑，五分钟快手菜。","category":"家常小炒","meat_tag":"素","difficulty":1,"minutes":10,"calorie_tier":"低","ingredients":[{"name":"洋葱","amount":"1个"},{"name":"鸡蛋","amount":"3个"},{"name":"盐","amount":"3g"},{"name":"小葱","amount":"1根"},{"name":"食用油","amount":"20ml"}],"steps":["洋葱对半切开顺纹切丝","鸡蛋加盐打散至起泡","热油倒蛋液，凝固后划散盛出","补少许油下洋葱丝炒2分钟至半透明","回锅鸡蛋加盐翻匀，撒葱花出锅"],"nutrition":{"kcal":250,"protein":11,"fat":19,"carb":10}},
{"name":"韭菜炒鸡蛋","intro":"春韭最香，简单三步就好吃。","category":"家常小炒","meat_tag":"素","difficulty":1,"minutes":10,"calorie_tier":"中","ingredients":[{"name":"韭菜","amount":"200g"},{"name":"鸡蛋","amount":"3个"},{"name":"盐","amount":"3g"},{"name":"食用油","amount":"20ml"}],"steps":["韭菜洗净沥干，切3厘米段","鸡蛋加盐彻底打散","热油倒蛋液炒至刚凝固盛出","原锅下韭菜梗炒30秒再下叶","回锅鸡蛋快速翻匀立即出锅，久炒韭菜出水"],"nutrition":{"kcal":260,"protein":12,"fat":20,"carb":9}},
{"name":"苦瓜炒蛋","intro":"苦尽甘来，清热降火的家常味。","category":"家常小炒","meat_tag":"素","difficulty":1,"minutes":15,"calorie_tier":"低","ingredients":[{"name":"苦瓜","amount":"1根"},{"name":"鸡蛋","amount":"3个"},{"name":"盐","amount":"4g"},{"name":"蒜","amount":"1瓣"},{"name":"食用油","amount":"20ml"}],"steps":["苦瓜对半剖开，用勺刮净白瓤切薄片","加盐抓腌5分钟挤去苦水","鸡蛋打散，热油炒成大块盛出","爆香蒜末，下苦瓜大火炒1分钟","回锅鸡蛋加盐翻炒均匀即可"],"nutrition":{"kcal":200,"protein":11,"fat":15,"carb":9}},
{"name":"荷兰豆炒腊肠","intro":"腊肠油润豆脆甜，年夜饭常客。","category":"家常小炒","meat_tag":"荤","difficulty":1,"minutes":15,"calorie_tier":"中","ingredients":[{"name":"荷兰豆","amount":"200g"},{"name":"腊肠","amount":"2根"},{"name":"蒜","amount":"2瓣"},{"name":"盐","amount":"2g"},{"name":"食用油","amount":"10ml"}],"steps":["荷兰豆撕去两端老筋洗净","腊肠斜切成薄片","水开荷兰豆焯水1分钟过凉保脆","小火少油煸炒腊肠至透明出油","下蒜片和荷兰豆大火翻炒1分钟，加盐即可"],"nutrition":{"kcal":330,"protein":13,"fat":22,"carb":16}},
{"name":"回锅肉","intro":"川菜之魂，肥而不腻卷蒜苗绝了。","category":"家常小炒","meat_tag":"荤","difficulty":2,"minutes":40,"calorie_tier":"高","ingredients":[{"name":"五花肉","amount":"300g"},{"name":"青蒜苗","amount":"2根"},{"name":"豆瓣酱","amount":"20g"},{"name":"豆豉","amount":"5g"},{"name":"姜","amount":"3片"},{"name":"蒜","amount":"2瓣"},{"name":"料酒","amount":"10ml"},{"name":"生抽","amount":"10ml"},{"name":"白糖","amount":"3g"},{"name":"食用油","amount":"5ml"}],"steps":["整块五花肉冷水下锅，加姜片料酒煮20分钟至筷子能插透","捞出晾凉切2毫米薄片，蒜苗斜切段","热锅少油下肉片中火煸炒出油打卷，即灯盏窝","推到锅边下豆瓣酱豆豉姜蒜小火炒出红油","加生抽白糖调匀，最后下蒜苗炒断生出锅"],"nutrition":{"kcal":580,"protein":22,"fat":48,"carb":12}},
{"name":"农家小炒肉","intro":"湘菜招牌，青椒擂出来的镬气香。","category":"家常小炒","meat_tag":"荤","difficulty":2,"minutes":20,"calorie_tier":"中","ingredients":[{"name":"带皮五花肉","amount":"150g"},{"name":"青尖椒","amount":"4个"},{"name":"小米辣","amount":"2个"},{"name":"蒜","amount":"3瓣"},{"name":"豆豉","amount":"3g"},{"name":"生抽","amount":"10ml"},{"name":"老抽","amount":"3ml"},{"name":"盐","amount":"2g"},{"name":"食用油","amount":"15ml"}],"steps":["五花肉切薄片，青尖椒拍裂斜切段","干锅下青椒中火煸至起虎皮斑盛出","热油下肉片煸出油至边缘焦黄","下蒜片豆豉和小米辣炒香","回锅青椒，加生抽老抽盐大火炒匀出锅"],"nutrition":{"kcal":450,"protein":18,"fat":38,"carb":9}}
]
